# dependencies
node_modules/
.pnpm-store/

# build output
dist/
src-tauri/target/
src-tauri/gen/schemas/

# local tools and fetched binaries
tools/
src-tauri/binaries/
src-tauri/legal/FFMPEG-BUILD-INFO.txt
src-tauri/legal/FFMPEG-BUILD-LICENSE.txt
*.log

# environment
.env
.env.*
!.env.example

# signing keys. The Tauri CLI writes these next to the project when it
# generates an updater key, so they must never be committed.
.tauri/
**/.tauri/
*.key
*.key.pub

# editor / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db

# app cache / test output
coverage/
test-results/
playwright-report/
tests/fixtures/generated/
